# ============ COPY THIS FILE TO .env AND FILL IT IN ============

# 1. Your MongoDB Atlas connection string (free M0 cluster)
# Get it from: Atlas dashboard -> Connect -> Drivers -> "Add your connection string"
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/kpop?retryWrites=true&w=majority

# 2. Admin password for the admin panel (change this!)
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# 3. Port the server listens on (Railway sets PORT automatically; keep 3000 for local)
PORT=3000

# 4. For local dev only: where to serve the public site from.
# On Railway this is ignored (Railway serves the built site).
PUBLIC_DIR=../

# 5. Max upload size in MB (videos). Atlas free M0 = 512MB total storage,
# so keep this reasonable (e.g. 100MB).
MAX_UPLOAD_MB=100
